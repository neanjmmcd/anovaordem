<div class="armadura-item">

  <div class="linha">
    <label>Nome</label>
    <input type="text" name="system.name" value="{{system.name}}">
  </div>

  <div class="linha">
    <label>Conceito</label>
    <textarea name="system.conceito">{{system.conceito}}</textarea>
  </div>

  <div class="linha">
    <label>Essência</label>
    <input type="number" name="system.essencia" value="{{system.essencia}}">
  </div>

  <div class="linha">
    <label>Dano a Sanidade</label>
    <input type="number" name="system.dano" value="{{system.dano}}">
  </div>

  <div class="linha">
    <label>Efeito</label>
    <textarea name="system.efeito">{{system.efeito}}</textarea>
  </div>
  
  <div class="linha">
    <label>Circulo</label>
    <input type="number" name="system.circulo" value="{{system.circulo}}">
  </div>

</div>
