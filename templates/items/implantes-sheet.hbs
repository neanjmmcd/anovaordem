<div class="armadura-item">

  <div class="linha">
    <label>Nome</label>
    <input type="text" name="system.name" value="{{system.name}}">
  </div>

  <div class="linha">
    <label>Efeito</label>
    <input type="text" name="system.efeito" value="{{system.efeito}}">
  </div>

  <div class="linha">
    <label>Esssência</label>
    <input type="number" name="system.essencia" value="{{system.essencia}}">
  </div>

  <div class="linha">
    <label>Conceito</label>
    <input type="textarea" name="system.conceito" value="{{system.conceito}}">
  </div>

  <div class="linha">
    <label>Preço Base</label>
    <input type="number" name="system.preco" value="{{system.preco}}">
  </div>

  

</div>
