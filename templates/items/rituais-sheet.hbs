<div class="armadura-item">

  <div class="linha">
    <label>Nome</label>
    <input type="text" name="system.name" value="{{system.name}}">
  </div>

  <div class="linha">
    <label>Conceito</label>
    <textarea name="system.conceito">{{system.conceito}}</textarea>
  </div>

  <div class="linha">
    <label>Custo Essência</label>
    <textarea name="system.essencia">{{system.essencia}}</textarea>
  </div>

  <div class="linha">
    <label>Efeito</label>
    <textarea name="system.efeito">{{system.efeito}}</textarea>
  </div>

  <div class="linha">
    <label>Tempo</label>
    <textarea name="system.tempo">{{system.tempo}}</textarea>
  </div>

</div>
