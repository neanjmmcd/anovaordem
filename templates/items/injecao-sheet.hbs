<div class="armadura-item">

  <div class="linha">
    <label>Nome</label>
    <input type="text" name="system.name" value="{{system.name}}">
  </div>

  <div class="linha">
    <label>Efeitos</label>
    <textarea name="system.efeito">{{system.efeito}}</textarea>
  </div>

  <div class="linha">
    <label>Colateral</label>
    <textarea name="system.colateral">{{system.colateral}}</textarea>
  </div>

  <div class="linha">
    <label>Conceito</label>
    <textarea name="system.conceito">{{system.conceito}}</textarea>
  </div>

  <div class="linha">
    <label>Preço Base</label>
    <input type="text" name="system.preco" value="{{system.preco}}">
  </div>

</div>
