<div class="armadura-item">

  <div class="linha">
    <label>Nome</label>
    <input type="text" name="system.name" value="{{system.name}}">
  </div>

  <div class="linha">
    <label>Armamento / Ferramenta</label>
    <input type="text" name="system.tipo" value="{{system.tipo}}">
  </div>

  <div class="linha">
    <label>VEL</label>
    <input type="number" name="system.vel" value="{{system.vel}}">
  </div>

  <div class="linha">
    <label>EST</label>
    <input type="number" name="system.est" value="{{system.est}}">
  </div>

  <div class="linha">
    <label>BLD</label>
    <input type="number" name="system.bld" value="{{system.bld}}">
  </div>

  <div class="linha">
    <label>MOB</label>
    <input type="number" name="system.mob" value="{{system.mob}}">
  </div>

  <div class="linha">
    <label>PRE</label>
    <input type="number" name="system.pre" value="{{system.pre}}">
  </div>

  <div class="linha">
    <label>POT</label>
    <input type="number" name="system.pot" value="{{system.pot}}">
  </div>

  <div class="linha">
    <label>Preço Base</label>
    <input type="number" name="system.preco" value="{{system.preco}}">
  </div>


</div>
