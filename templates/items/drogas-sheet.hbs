<div class="armadura-item">

  <div class="linha">
    <label>Nome</label>
    <input type="text" name="system.nome" value="{{system.nome}}">
  </div>

  <div class="linha">
    <label>Tipo</label>
    <input type="text" name="system.tipo" value="{{system.tipo}}">
  </div>

  <div class="linha">
    <label>Efeito</label>
    <textarea name="system.efeito">{{system.efeito}}</textarea>
  </div>

  <div class="linha">
    <label>Efeito Colateral</label>
    <textarea name="system.colateral">{{system.colateral}}</textarea>
  </div>

</div>
