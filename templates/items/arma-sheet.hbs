<div class="armadura-item">

  <div class="linha">
    <label>Nome</label>
    <input type="text" name="system.name" value="{{system.name}}">
  </div>
  <div class="linha">
    <label>Dano</label>
    <input type="text" name="system.dano" value="{{system.dano}}">
  </div>

  <div class="linha">
    <label>Munição</label>
    <input type="number" name="system.ammo" value="{{system.ammo}}" min="0">
  </div>

  <div class="linha">
    <label>Tipo</label>
    <input type="text" name="system.tipo" value="{{system.tipo}}">
  </div>

  <div class="linha">
    <label>Conceito</label>
    <input type="text" name="system.conceito" value="{{system.conceito}}">
  </div>

  <div class="linha">
    <label>V/T</label>
    <input type="number" name="system.vt" value="{{system.vt}}">
  </div>

  <div class="linha">
    <label>Peso</label>
    <input type="number" name="system.peso" value="{{system.peso}}">
  </div>

  <div class="linha">
    <label>Preço Base</label>
    <input type="number" name="system.preco" value="{{system.preco}}">
  </div>
 


</div>
