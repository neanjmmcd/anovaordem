<div class="armadura-item">

  <div class="linha">
    <label>Pedra</label>
    <input type="text" name="system.pedra" value="{{system.pedra}}">
  </div>
  <div class="linha">
    <label>Nível</label>
    <input type="number" name="system.nivel" value="{{system.nivel}}">
  </div>

  <div class="linha">
    <label>Técnica</label>
    <input type="text" name="system.tecnica" value="{{system.tecnica}}">
  </div>

  <div class="linha">
    <label>Tipo</label>
    <input type="text" name="system.tipo" value="{{system.tipo}}">
  </div>

  <div class="linha">
    <label>Alvo/Efeito</label>
    <textarea name="system.alvo">{{system.alvo}}</textarea>
  </div>

  <div class="linha">
    <label>Efeito Secundário</label>
    <textarea name="system.efeito">{{system.efeito}}</textarea>
  </div>

  <div class="linha">
    <label>Dano</label>
    <input type="text" name="system.dano" value="{{system.dano}}">
  </div>

</div>
