<div class="armadura-item">

  <div class="linha">
    <label>Tipo</label>
    <input type="text" name="system.tipo" value="{{system.tipo}}">
  </div>

  <div class="linha">
    <label>Peso</label>
    <input type="number" name="system.peso" value="{{system.peso}}">
  </div>

  <div class="linha">
    <label>Preço Base</label>
    <input type="text" name="system.preco" value="{{system.preco}}">
  </div>

  <div class="linha">
    <label>efeitos</label>
    <textarea name="system.efeitos">{{system.efeitos}}</textarea>
  </div>

  <div class="linha">
    <label>Conceito</label>
    <textarea name="system.conceito">{{system.conceito}}</textarea>
  </div>

</div>
