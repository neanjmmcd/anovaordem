  "download": "https://github.com/neanjmmcd/anovaordem/archive/refs/heads/main.zip",
  "compatibility": {
    "minimum": "13",
    "verified": "13.351"
  },
  "relationships": {
    "recommends": [
      {
        "id": "item-piles",
        "type": "module",
        "reason": "Saque, baús e lojas usando ¢RD (integração nativa do sistema)",
        "compatibility": {
          "verified": "3.3.2"
        }
      },
      {
        "id": "autoanimations",
        "type": "module",
        "reason": "Toca as animações próprias do sistema (instale pelo menu Animações do Sistema)",
        "compatibility": {
          "verified": "6.6.2"
        }
      },
      {
        "id": "sequencer",
        "type": "module",
        "reason": "Necessário para o Automated Animations",
        "compatibility": {
          "verified": "3.6.11"
        }
      },
      {
        "id": "socketlib",
        "type": "module",
        "reason": "Necessário para o Automated Animations"
      },
      {
        "id": "JB2A_DnD5e",
        "type": "module",
        "reason": "Opcional: animações extras (o sistema já traz efeitos próprios)"
      },
      {
        "id": "dice-so-nice",
        "type": "module",
        "reason": "Dados 3D nas rolagens (opcional)"
      }
    ]
  },
  "esmodules": [
    "scripts/init.js",
    "scripts/sheet.js",
    "scripts/rolls.js"
  ],
