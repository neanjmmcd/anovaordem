{
  "id": "a-nova-ordem",
  "title": "A Nova Ordem",
  "description": "Sistema dieselpunk 1975 criado por Alê Gomes e programado por NeaN World",
  "version": "0.7.0",
  "authors": [
    {
      "name": "Alê Gomes",
      "role": "Criador do Sistema"
    },
    {
      "name": "NeaN World",
      "role": "Programador"
    }
  ],
  "url": "https://github.com/neanjmmcd/anovaordem",
